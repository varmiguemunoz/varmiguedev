---
import { Image } from 'astro:assets';
import config from '@config/config.json';
import social from '@config/social';

const socialItems = social.networks;
---

<section class="mx-auto mt-10 w-full">
  <div class="mx-auto w-full max-w-screen-lg px-4 py-0 pb-6 sm:px-6 sm:pb-12 lg:px-8">
    <div class="flex items-start justify-between">
      <div class="w-3/5 rounded-lg md:w-1/2">
        <h1 class="mb-0 text-lg font-bold text-zinc-900 dark:text-white sm:text-3xl md:text-2xl">
          {config.author.name}
        </h1>
        <p class="mt-1.5 text-sm text-zinc-500 dark:text-zinc-400 md:text-lg">
          {config.author.bio}
        </p>
        <div class="m-auto flex space-x-4 pt-8">
          {
            socialItems?.map((item) => (
              <a href={item.url} target="_blank" rel="noopener noreferrer">
                <figure>
                  <Fragment set:html={item.svg} />
                </figure>
              </a>
            ))
          }
        </div>
      </div>
      <div class="rounded-lg">
        <figure class="right-0">
          <Image
            class="h-[180px] w-[180px] rounded-lg object-contain md:h-[400px] md:w-[400px]"
            width={350}
            height={350}
            src={config.author.avatar}
            alt={config.author.name}
            decoding="async"
            loading="lazy"
            quality={'max'}
            id={'banner-image'}
          />
        </figure>
      </div>
    </div>
  </div>
</section>
