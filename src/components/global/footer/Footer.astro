---
import social from '@config/social';

const socialItems = social.networks;

const year = new Date().getFullYear();
---

<footer class="mx-auto max-w-screen-lg border-t border-zinc-100 dark:border-zinc-900">
  <div class="flex w-full items-center justify-between px-4 py-6 sm:px-6 lg:px-8">
    <div>
      <p class="text-center text-xs/relaxed text-zinc-500 dark:text-zinc-400">
        &copy; {year} - All rights reserved | varmiguemunoz
      </p>
    </div>

    <div class="hidden space-x-4 md:flex">
      {
        socialItems?.map((item) => (
          <a href={item.url} target="_blank" rel="noopener noreferrer">
            <figure>
              <Fragment set:html={item.svg} />
            </figure>
          </a>
        ))
      }
    </div>
  </div>
</footer>
