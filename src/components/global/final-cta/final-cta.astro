---
import { Button } from '@/components/ui/button';
import { ArrowRight } from 'lucide-react';

const CAL_LINK =
  'https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ3T7zeEOYTFQmof-sbNifFo37K0uW123TO1tf3L6AEUr-2qhDbR8Txol7-9zoAdi6NfmfNTOtQs';
---

<section class="relative overflow-hidden px-6 py-24 lg:py-32">
  <!-- Background -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-accent/5 to-primary/10"></div>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,_var(--tw-gradient-stops))] from-accent/10 via-transparent to-transparent"
  >
  </div>

  <!-- Decorative Orbs -->
  <div class="absolute -left-20 bottom-0 h-48 w-48 rounded-full bg-primary/10 blur-[80px]"></div>
  <div class="absolute -right-20 top-0 h-48 w-48 rounded-full bg-accent/10 blur-[80px]"></div>

  <div class="relative z-10 mx-auto max-w-3xl text-center">
    <h2 class="mb-6 text-balance text-4xl font-bold tracking-[-0.03em] text-foreground md:text-5xl lg:text-6xl">
      Tell me what's stuck
    </h2>

    <p class="mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-muted-foreground md:text-xl">
      Send me two lines on what you want to build or automate, and where it's stuck today. I'll reply
      within 24 hours with a direct read on whether it's a fit — book a call or just start the thread.
    </p>

    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a href={CAL_LINK}>
        <Button variant="hero" size="xl" className="group">
          Book a Discovery Call
          <ArrowRight className="ml-2 h-5 w-5 transition-transform group-hover:translate-x-1" />
        </Button>
      </a>
      <a href="mailto:varmiguemunoz@gmail.com?subject=Project%20inquiry">
        <Button variant="outline" size="xl" className="hover:bg-white hover:text-black">
          Email me two lines
        </Button>
      </a>
    </div>

    <p class="mt-6 text-sm text-muted-foreground/60">
      No commitment · Replies within 24 hours · Available in English and Spanish
    </p>
  </div>
</section>
