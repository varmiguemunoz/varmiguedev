---
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { ArrowRight, Calendar } from 'lucide-react';

type Props = {
  getCategoryLabel: (parameter: any) => void | any;
  formatDate: (parameter: any) => void;
  selectedCategory: string;
  filteredPosts: {
    data: {
      image: string;
      title: string;
      id: string;
      category: string;
      date: string;
      description: string;
      readTime: string;
    };
  }[];
};

const { getCategoryLabel, selectedCategory, filteredPosts, formatDate } = Astro.props;
---

<section class="w-full overflow-hidden">
  <div class="mb-8 flex items-center justify-between">
    <h2 class="text-2xl font-bold text-foreground md:text-3xl">
      {selectedCategory === 'all' ? 'Latest Articles' : `${getCategoryLabel(selectedCategory)} Articles`}
    </h2>
    <div class="text-sm text-muted-foreground">
      {filteredPosts.length} article{filteredPosts.length !== 1 ? 's' : ''}
    </div>
  </div>

  <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
    {
      filteredPosts.map((post) => (
        <Card
          key={post.data.id}
          className="group cursor-pointer overflow-hidden border-border bg-gradient-card transition-all duration-300 hover:border-accent/30 hover:shadow-accent-glow"
        >
          {/* Image */}
          <div class="relative overflow-hidden">
            <img
              src={post.data.image}
              alt={post.data.title}
              class="h-48 w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-background/60 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
          </div>

          <CardHeader className="pb-3">
            <div class="mb-2 flex items-center justify-between">
              <Badge variant="outline" className="border-accent/30 text-xs text-accent-glow">
                {getCategoryLabel(post.data.category)}
              </Badge>
              <div class="flex items-center text-xs text-muted-foreground">
                <Calendar className="mr-1 h-3 w-3" />
                <span>{formatDate(post.data.date)}</span>
              </div>
            </div>

            <CardTitle className="text-lg leading-tight transition-colors duration-300 group-hover:text-primary-glow">
              {post.data.title}
            </CardTitle>
          </CardHeader>

          <CardContent className="pt-0">
            <CardDescription className="mb-4 leading-relaxed text-muted-foreground">
              {post.data.description}
            </CardDescription>

            <div class="flex items-center justify-between">
              <span class="text-xs text-muted-foreground">{post.data.readTime}</span>
              <Button
                variant="ghost"
                size="sm"
                className="p-0 transition-colors duration-300 group-hover:text-primary-glow"
              >
                Read More
                <ArrowRight className="ml-1 h-3 w-3 transition-transform duration-300 group-hover:translate-x-1" />
              </Button>
            </div>
          </CardContent>
        </Card>
      ))
    }
  </div>

  {
    filteredPosts.length === 0 && (
      <div class="py-16 text-center">
        <p class="text-lg text-muted-foreground">No articles found in this category.</p>
      </div>
    )
  }
</section>
