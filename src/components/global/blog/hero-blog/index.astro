---
import { Filter } from 'lucide-react';
import { Button } from '@/components/ui/button';

type Props = {
  showFilters: boolean;
  selectedCategory: string;
  categories: {
    id: string;
    label: string;
  }[];
};

const { showFilters, selectedCategory, categories } = Astro.props;
---

<section class="px-4 pb-16 pt-24">
  <div class="mx-auto w-full max-w-6xl text-center">
    <div class="relative">
      {/* Background glow effect */}
      <div class="absolute inset-0 scale-150 rounded-full bg-gradient-primary opacity-10 blur-3xl"></div>

      <div class="relative">
        <h1 class="mb-6 text-4xl font-bold leading-tight text-foreground md:text-6xl lg:text-7xl">
          Insights, code, and{' '}
          <span class="bg-gradient-primary bg-clip-text text-transparent">client growth strategies</span>
        </h1>

        <p class="mx-auto mb-8 max-w-4xl text-xl leading-relaxed text-muted-foreground md:text-2xl">
          A development blog for agencies, founders, and digital operators
        </p>

        {/* Category Filter */}
        <div class="mb-8 flex flex-wrap justify-center gap-3">
          <Button variant="ghost" size="sm" className="md:hidden">
            <Filter className="mr-2 h-4 w-4" />
             Filter
          </Button>

          <div class={`flex flex-wrap justify-center gap-3 ${showFilters ? 'block' : 'hidden md:flex'}`}>
            {
              categories.map((category) => (
                <Button
                  key={category.id}
                  variant={selectedCategory === category.id ? 'default' : 'outline'}
                  size="sm"
                  className="transition-all duration-300 hover:scale-105"
                >
                  {category.label}
                </Button>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
