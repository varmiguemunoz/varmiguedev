---
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { ExternalLink, Linkedin } from 'lucide-react';
---

<section class="px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <div class="grid items-center gap-16 lg:grid-cols-2">
      {/* Photo */}
      <div class="relative">
        <div class="aspect-square relative">
          <div class="absolute inset-0 rounded-3xl bg-gradient-to-br from-primary/20 to-accent/20 blur-3xl"></div>
          <div class="relative h-full overflow-hidden rounded-3xl border border-primary/20 bg-gradient-card">
            <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-primary/10 to-accent/10">
              <img src="/herov3.png" alt="icon" loading="lazy" width="auto" height="auto" />
            </div>
          </div>
        </div>
      </div>

      {/* Bio Content */}
      <div class="space-y-8">
        <div>
          <Badge variant="outline" className="mb-4 border-primary text-primary">About Miguel</Badge>
          <h2 class="mb-6 text-3xl font-bold text-foreground md:text-4xl">
            5+ Years Building Digital Products That Scale
          </h2>
        </div>

        <div class="space-y-6 text-lg leading-relaxed text-muted-foreground">
          <p>
            <span class="font-semibold text-primary">I’ve supported 100+</span> successful client launches by helping
            agencies accelerate development, expand their capabilities, and deliver exceptional results to their
            clients.
          </p>

          <p>
            I partner with agencies to build <span class="font-semibold text-accent"
              >scalable, efficient, and reliable digital systems</span
            > from websites and internal tools to automations and client-facing apps. The result? Faster delivery,
            cleaner execution, and stronger client outcomes.
          </p>

          <p>
            My approach? <span class="font-semibold text-primary"
              >Clean code, clear communication, and consistent delivery.</span
            > Whether you need dev hours to support client work or a hands-on technical partner for complete builds, I
            plug into your team and keep things moving.
          </p>
        </div>

        {/* CTAs */}
        <div class="flex flex-col gap-4 sm:flex-row">
          <a href="/pricing">
            <Button variant="outline" className="group hover:bg-white hover:text-black">
              <ExternalLink className="mr-2 h-4 w-4 " />
               View Services
            </Button>
          </a>
          <a href="https://www.linkedin.com/in/varmiguemunoz/">
            <Button variant="outline" className="group hover:bg-white hover:text-black">
              <Linkedin className="mr-2 h-4 w-4 " />
               Connect on LinkedIn
            </Button>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
