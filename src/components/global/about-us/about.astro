---
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { ExternalLink, Linkedin } from 'lucide-react';
---

<section class="px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <div class="grid items-center gap-16 lg:grid-cols-2">
      {/* Photo */}
      <div class="relative">
        <div class="aspect-square relative">
          <div class="absolute inset-0 rounded-3xl bg-gradient-to-br from-primary/20 to-accent/20 blur-3xl"></div>
          <div class="relative h-full overflow-hidden rounded-3xl border border-primary/20 bg-gradient-card">
            <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-primary/10 to-accent/10">
              <img src="/profilev2.png" alt="icon" loading="lazy" width="auto" height="auto" />
            </div>
          </div>
        </div>
      </div>

      {/* Bio Content */}
      <div class="space-y-8">
        <div>
          <Badge variant="outline" className="mb-4 border-primary text-primary">About Miguel</Badge>
          <h2 class="mb-6 text-3xl font-bold text-foreground md:text-4xl">
            5+ Years Building Digital Products That Scale
          </h2>
        </div>

        <div class="space-y-6 text-lg leading-relaxed text-muted-foreground">
          <p>
            <span class="font-semibold text-primary">I help digital agencies</span> deliver faster, scale smarter, and
            impress their clients — without burning out their dev team.
          </p>

          <p>
            With over <span class="font-semibold text-accent">100 successful launches</span> I’ve become the
            behind-the-scenes dev partner agencies trust to build everything from marketing sites and internal tools to
            complex automations and custom apps.
          </p>

          <p>
            My role is simple: <span class="font-semibold text-primary"
              >I plug into your team, speak your language, and get things shipped.</span
            > Clean code, proactive communication, and consistent delivery — that’s how I help agencies stay ahead,
            project after project.
          </p>
        </div>

        {/* CTAs */}
        <div class="flex flex-col gap-4 sm:flex-row">
          <a href="/pricing">
            <Button variant="outline" className="group hover:bg-white hover:text-black">
              <ExternalLink className="mr-2 h-4 w-4 " />
               View Services
            </Button>
          </a>
          <a href="https://www.linkedin.com/in/varmiguemunoz/">
            <Button variant="outline" className="group hover:bg-white hover:text-black">
              <Linkedin className="mr-2 h-4 w-4 " />
               Connect on LinkedIn
            </Button>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
