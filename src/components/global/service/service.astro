---
import { Badge } from '@/components/ui/badge';
import { Zap, Code, Clock, Users } from 'lucide-react';

const values = [
  {
    icon: <Zap className="h-6 w-6" />,
    keyword: 'Speed',
    description: '48hr turnaround on most requests',
  },
  {
    icon: <Code className="h-6 w-6" />,
    keyword: 'Quality',
    description: 'Clean, scalable, production-ready code',
  },
  {
    icon: <Clock className="h-6 w-6" />,
    keyword: 'Flexibility',
    description: 'Async support across timezones',
  },
  {
    icon: <Users className="h-6 w-6" />,
    keyword: 'Scale',
    description: 'Handle multiple client projects simultaneously',
  },
];
---

<section class="px-6 py-24">
  <div class="mx-auto max-w-6xl text-center">
    <Badge variant="outline" className="mb-6 border-primary text-primary">Why Agencies Choose Me</Badge>

    <h2 class="mb-8 text-4xl font-bold leading-tight text-foreground md:text-5xl">
      I'm the technical co-founder your agency needs, without the equity or full-time commitment.
    </h2>

    <p class="mx-auto mb-16 max-w-4xl text-xl leading-relaxed text-muted-foreground">
      While you focus on clients and growth, I handle the complex development work that scales your business. From
      custom web applications to mobile apps and infrastructure automation — consistent, reliable, monthly.
    </p>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {
        values.map((value, index) => (
          <div class="group">
            <div class="flex flex-col items-center space-y-4 rounded-lg border border-border bg-gradient-card p-6 transition-all duration-300 hover:border-primary/20 hover:shadow-glow">
              <div class="rounded-lg bg-primary/10 p-3 text-primary transition-all duration-300 group-hover:bg-primary group-hover:text-white">
                {value.icon}
              </div>
              <h3 class="text-lg font-semibold text-foreground">{value.keyword}</h3>
              <p class="text-center text-sm text-muted-foreground">{value.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
