---
import Button from "@components/Button.astro";

type Props = {
  url?: string;
};

const { url = "#form" } = Astro.props;
---

<div
  class="flex flex-col lg:flex-row gap-7 justify-evenly border rounded-xl py-16 border-gray-300 max-w-[1240px] w-full mx-auto px-4 sm:px-8 lg:px-12 mb-10"
>
  <div class="flex justify-center flex-col gap-2 md:text-left text-center">
    <h1 class="text-3xl sm:text-3xl font-bold leading-tight">
      Only 5 free implementations this month
    </h1>

    <p class="text-gray-500 font-normal">
      Don't miss this opportunity to get your AI Agent for free
    </p>
  </div>

  <div class="flex justify-center">
    <a href={url}>
      <Button color="blue" size="auto">Get in touch</Button>
    </a>
  </div>
</div>
