---

---

<section class="bg-[#FAFCFA] py-20 px-4">
  <div class="max-w-6xl mx-auto text-center">
    <!-- Título -->
    <h2 class="text-3xl md:text-4xl font-bold text-black mb-3">
      Talk with sales department
    </h2>
    <p class="text-gray-600 text-lg mb-16">
      Grow your business with AI Agents, save time, money and get more benefits.
    </p>

    <!-- Opciones -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Llamada -->
      <div class="flex flex-col items-center">
        <div
          class="bg-gradient-to-br from-green-300 to-cyan-300 w-16 h-16 rounded-full flex items-center justify-center mb-4"
        >
          <!-- Teléfono -->
          <svg
            class="w-6 h-6 text-black"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 5a2 2 0 012-2h3l2 5-2 2a16 16 0 006 6l2-2 5 2v3a2 2 0 01-2 2h-1C8.94 22 2 15.06 2 6V5z"
            ></path>
          </svg>
        </div>
        <h3 class="font-semibold text-lg text-black">Contact us</h3>
        <a href="tel:+57 302-327-8057" class="text-blue-700 underline"
          >+57 302-327-8057</a
        >
      </div>

      <!-- Correo -->
      <div class="flex flex-col items-center">
        <div
          class="bg-gradient-to-br from-green-300 to-cyan-300 w-16 h-16 rounded-full flex items-center justify-center mb-4"
        >
          <!-- Correo -->
          <svg
            class="w-6 h-6 text-black"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16 12H8m0 0H5m3 0h3m4-8H7a2 2 0 00-2 2v14l7-5 7 5V6a2 2 0 00-2-2z"
            ></path>
          </svg>
        </div>
        <h3 class="font-semibold text-lg text-black">Send us an email</h3>
        <a
          href="mailto:miguelmunoz@bloomify.tech"
          class="text-blue-700 underline">miguelmunoz@bloomify.tech</a
        >
      </div>

      <!-- Chat en línea -->
      <div class="flex flex-col items-center">
        <div
          class="bg-gradient-to-br from-green-300 to-cyan-300 w-16 h-16 rounded-full flex items-center justify-center mb-4"
        >
          <!-- Chat -->
          <svg
            class="w-6 h-6 text-black"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2v10z"
            ></path>
          </svg>
        </div>
        <h3 class="font-semibold text-lg text-black">Live chat</h3>
        <a href="https://api.whatsapp.com/send?phone=+573023278057">
          <p
            class="text-blue-700 mt-1 flex items-center text-center gap-1 hover:text-blue-800 cursor-pointer"
          >
            Start the free trial
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </p>
        </a>
      </div>
    </div>
  </div>
</section>
