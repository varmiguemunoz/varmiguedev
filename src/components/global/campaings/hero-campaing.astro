---

---

<section class="bg-white px-6 py-5 md:py-20 md:px-20 lg:px-36">
  <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-10 items-center">
    <!-- Texto -->
    <div>
      <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-6">
        Boost sales and <br />
        customer loyalty with<br />
        <span class="text-blue-600"> AI-powered agents</span>
      </h1>
      <p class="text-gray-600 text-lg mb-4">
        Streamline your order management, engage more customers, and grow your
        revenue with 24/7 smart AI agents on all your platforms.
      </p>
      <div class="flex items-center space-x-2 text-sm text-gray-700 mb-6">
        <span>⭐ 4.7</span>
        <span>•</span>
        <span>4,000+ clients</span>
      </div>
      <div class="flex flex-wrap gap-4">
        <a
          href="/sales#form"
          class="bg-blue-600 text-white px-6 py-3 rounded-xl font-medium hover:bg-blue-700 transition"
        >
          Get started
        </a>
        <a
          href="/sales#form"
          class="border border-blue-600 text-blue-600 px-6 py-3 rounded-xl font-medium hover:bg-blue-50 transition"
        >
          Request a demo
        </a>
      </div>
    </div>

    <!-- Imagen -->
    <div class="relative">
      <img
        src="/sapify.png"
        alt="Agente IA trabajando"
        class="w-full"
        width="500"
        height="500"
        loading="lazy"
        referrerpolicy="no-referrer"
      />

      <!-- Ficha de usuario -->
      <div
        class="absolute top-4 right-4 bg-white border shadow-md rounded-xl px-4 py-2 text-sm w-56 hidden md:block"
      >
        <div class="font-semibold text-gray-800 mb-1">✨ AI Responded</div>
        <p class="text-gray-600">
          Automate your sales process and let AI handle first contact,
          follow-ups, and even lead qualification.
        </p>
      </div>

      <!-- Insights -->
      <div
        class="absolute bottom-4 right-4 bg-white border shadow-md rounded-xl px-4 py-2 text-sm w-56"
      >
        <div class="font-semibold text-gray-800">📊 AI chat</div>
        <p class="text-gray-600">
          Respond to questions, complaints, or requests with intelligent agents
          available 24/7 on all your channels.
        </p>
      </div>

      <!-- Asignación -->
      <div
        class="absolute bottom-4 left-4 bg-white border shadow-md rounded-xl px-4 py-2 text-sm w-56 hidden md:block"
      >
        <div class="font-semibold text-gray-800">🧠 AI Business</div>
        <ul class="text-gray-600 mt-1">
          <li>
            We build AI agents tailored to your business rules, tone, and
            workflows.
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
