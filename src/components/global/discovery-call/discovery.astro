---
import { Button } from '@/components/ui/button';
import { Calendar, Clock, CheckCircle } from 'lucide-react';
---

<section class="px-4 py-24">
  <div class="mx-auto max-w-4xl">
    <div
      class="group rounded-lg border border-border bg-gradient-card p-8 transition-all duration-300 hover:border-primary/20 hover:shadow-glow md:p-12"
    >
      <div class="mb-8 text-center">
        <div class="mb-6 inline-flex h-16 w-16 items-center justify-center rounded-full bg-primary/10">
          <Calendar className="h-8 w-8 text-primary" />
        </div>

        <h2 class="mb-4 text-3xl font-bold text-foreground md:text-4xl">Let's Talk About Your Stack</h2>

        <p class="mx-auto mb-8 max-w-2xl text-xl text-muted-foreground">
          Book a 30-min discovery call and I'll audit your current dev needs, tech stack gaps, and show you how a
          monthly development partner can accelerate your agency's growth.
        </p>
      </div>

      <div class="mb-8 grid gap-6 md:grid-cols-3">
        <div class="flex items-center space-x-3">
          <CheckCircle className="h-5 w-5 flex-shrink-0 text-accent" />
          <span class="text-sm text-muted-foreground">Free technical audit</span>
        </div>
        <div class="flex items-center space-x-3">
          <Clock className="h-5 w-5 flex-shrink-0 text-accent" />
          <span class="text-sm text-muted-foreground">15 minutes, no sales pitch</span>
        </div>
        <div class="flex items-center space-x-3">
          <CheckCircle className="h-5 w-5 flex-shrink-0 text-accent" />
          <span class="text-sm text-muted-foreground">Custom solution roadmap</span>
        </div>
      </div>

      <div class="text-center">
        <a href="https://calendly.com/miguelmunoz-bloomify/30min">
          <Button
            client:load
            size="lg"
            className="bg-gradient-primary px-8 py-6 text-lg font-semibold text-white transition-all duration-300 hover:shadow-glow"
          >
            Schedule Discovery Call
          </Button>
          <p class="mt-3 text-sm text-muted-foreground">Immediate response</p>
        </a>
      </div>
    </div>
  </div>
</section>
