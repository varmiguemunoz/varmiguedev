---
import { Button } from '@/components/ui/button';
import { Calendar, Clock, CheckCircle } from 'lucide-react';
---

<section class="px-4 py-24">
  <div class="mx-auto max-w-4xl">
    <div
      class="bg-gradient-card border-border hover:shadow-glow hover:border-primary/20 group rounded-lg border p-8 transition-all duration-300 md:p-12"
    >
      <div class="mb-8 text-center">
        <div class="bg-primary/10 mb-6 inline-flex h-16 w-16 items-center justify-center rounded-full">
          <Calendar className="text-primary h-8 w-8" />
        </div>

        <h2 class="text-foreground mb-4 text-3xl font-bold md:text-4xl">Let's Talk About Your Stack</h2>

        <p class="text-muted-foreground mx-auto mb-8 max-w-2xl text-xl">
          Book a 15-min discovery call and I'll audit your current dev needs, tech stack gaps, and show you how a
          monthly development partner can accelerate your agency's growth.
        </p>
      </div>

      <div class="mb-8 grid gap-6 md:grid-cols-3">
        <div class="flex items-center space-x-3">
          <CheckCircle className="text-accent h-5 w-5 flex-shrink-0" />
          <span class="text-muted-foreground text-sm">Free technical audit</span>
        </div>
        <div class="flex items-center space-x-3">
          <Clock className="text-accent h-5 w-5 flex-shrink-0" />
          <span class="text-muted-foreground text-sm">15 minutes, no sales pitch</span>
        </div>
        <div class="flex items-center space-x-3">
          <CheckCircle className="text-accent h-5 w-5 flex-shrink-0" />
          <span class="text-muted-foreground text-sm">Custom solution roadmap</span>
        </div>
      </div>

      <div class="text-center">
        <Button
          client:load
          size="lg"
          className="bg-gradient-primary hover:shadow-glow px-8 py-6 text-lg font-semibold text-white transition-all duration-300"
        >
          Schedule Discovery Call
        </Button>
        <p class="text-muted-foreground mt-3 text-sm">Usually responds within 2 hours</p>
      </div>
    </div>
  </div>
</section>
