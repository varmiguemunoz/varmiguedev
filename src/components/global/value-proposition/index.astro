---
// Static, presentational block – no logic inside (per user rules)
---

<section id="value-proposition" class="px-4 py-5 sm:py-10">
  <div class="mx-auto w-full max-w-7xl">
    <div class="rounded-2xl border border-border bg-gradient-card p-6 sm:p-8">
      <div class="grid gap-6 sm:grid-cols-3">
        <div class="flex items-start gap-4">
          <div
            class="bg-primary/15 mt-1 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-primary"
          >
            <!-- Inline SVG icon -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
              <path
                d="M4 6a2 2 0 0 1 2-2h5v4H6a2 2 0 0 1-2-2Zm9-2h5a2 2 0 0 1 2 2v2h-7V4Zm7 6H4v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8Z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="mb-1 text-base font-semibold text-foreground">Frictionless development</h3>
            <p class="text-sm leading-relaxed text-muted-foreground">
              I integrate into your workflow without endless onboarding.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div
            class="bg-accent/15 mt-1 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-accent"
          >
            <!-- Inline SVG icon -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
              <path d="M11 3a1 1 0 0 1 2 0v7h4a1 1 0 1 1 0 2h-4v7a1 1 0 1 1-2 0v-7H7a1 1 0 0 1 0-2h4V3Z"></path>
            </svg>
          </div>
          <div>
            <h3 class="mb-1 text-base font-semibold text-foreground">Speed and quality</h3>
            <p class="text-sm leading-relaxed text-muted-foreground">Clean code, fast delivery, 24-hour support.</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div
            class="bg-primary/15 mt-1 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-primary"
          >
            <!-- Inline SVG icon -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
              <path
                d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="mb-1 text-base font-semibold text-foreground">Direct relationship</h3>
            <p class="text-sm leading-relaxed text-muted-foreground">
              You look good in front of the client, I make it work.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
