---
import { Building2, Megaphone, Rocket } from 'lucide-react';

const clients = [
  {
    icon: Building2,
    title: 'Business Owners',
    subtitle: 'Automating their operations',
    description:
      'Your business runs on manual processes, spreadsheets and people doing repetitive work. I replace that with AI systems that run themselves — finance ops, sales pipelines, WhatsApp support and internal workflows.',
    note: 'Not Zapier flows. Engineered infrastructure built to run without you.',
    timeline: '4–10 weeks',
  },
  {
    icon: Megaphone,
    title: 'Agencies',
    subtitle: 'That need real AI infrastructure',
    description:
      'You sell results to clients. I build the systems that deliver them — AI agents, automation workflows, CRM integrations and backend systems your team can deploy across accounts.',
    note: "You focus on selling. I build what you're selling.",
    timeline: '2–5 weeks',
  },
  {
    icon: Rocket,
    title: 'Startups',
    subtitle: 'Building serious products',
    description:
      "If you're building a real product, you need real architecture. AI-first applications, multi-agent systems and Go backends engineered to survive real load from day one.",
    note: 'One engineer. Full stack. No handoffs.',
    timeline: '4–12 weeks',
  },
];
---

<section class="px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <!-- Header -->
    <div class="mb-16 text-center">
      <h2 class="mb-6 text-4xl font-bold tracking-[-0.02em] text-foreground md:text-5xl">Who I work with</h2>
      <p class="mx-auto max-w-3xl text-xl text-muted-foreground">
        I don't take every project. I work with three types of clients — and I build exactly what each one needs.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid gap-8 lg:grid-cols-3">
      {clients.map(({ icon: Icon, ...client }) => (
        <div class="group flex flex-col rounded-2xl border border-border/30 bg-gradient-card p-8 transition-all duration-300 hover:border-primary/20 hover:shadow-glow">
          <!-- Icon + Title -->
          <div class="mb-6">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary transition-colors duration-300 group-hover:bg-primary/20">
              <Icon className="h-6 w-6" />
            </div>
            <h3 class="text-xl font-bold text-foreground">{client.title}</h3>
            <p class="mt-1 text-sm font-medium text-primary">{client.subtitle}</p>
          </div>

          <!-- Description -->
          <p class="mb-4 flex-1 leading-relaxed text-muted-foreground">
            {client.description}
          </p>

          <!-- Note -->
          <p class="mb-6 text-sm font-medium italic text-foreground/80">
            {client.note}
          </p>

          <!-- Timeline Badge -->
          <div class="mt-auto">
            <span class="inline-block rounded-full bg-accent/10 px-4 py-1.5 text-sm font-medium text-accent">
              Timeline: {client.timeline}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
