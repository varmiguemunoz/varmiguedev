---
import type { CaseKind } from './data';

interface Props {
  kind: CaseKind;
}
const { kind } = Astro.props;

const node = { fill: '#16263C', stroke: '#2F6BFF', 'stroke-opacity': '0.7' };
const label = { fill: '#EEF1F4', 'font-size': '13', 'font-weight': '600', 'text-anchor': 'middle' };
const sub = { fill: '#8FA1B8', 'font-size': '10.5', 'text-anchor': 'middle' };
---

<svg viewBox="0 0 480 340" class="block h-auto w-full" aria-hidden="true" data-diagram>
  {
    kind === 'finance' && (
      <>
        <path class="ops-line" data-draw d="M130 170 L196 170" />
        <path class="ops-line" data-draw d="M284 170 C 320 170, 320 78, 350 78" />
        <path class="ops-line" data-draw d="M284 170 L350 170" />
        <path class="ops-line" data-draw d="M284 170 C 320 170, 320 262, 350 262" />
        <path class="ops-flow" d="M130 170 L196 170" />
        <path class="ops-flow" d="M284 170 C 320 170, 320 78, 350 78" />
        <path class="ops-flow" d="M284 170 L350 170" />
        <path class="ops-flow" d="M284 170 C 320 170, 320 262, 350 262" />

        <g data-node>
          <rect x="20" y="144" width="110" height="52" rx="10" {...node} />
          <text x="75" y="167" {...label}>WhatsApp</text>
          <text x="75" y="184" {...sub}>photo · PDF · text</text>
        </g>
        <g data-node>
          <circle cx="240" cy="170" r="44" fill="#16263C" stroke="#F2A93B" stroke-width="1.5" />
          <text x="240" y="167" {...label}>AI agent</text>
          <text x="240" y="184" {...sub}>extract · classify</text>
        </g>
        <g data-node>
          <rect x="350" y="56" width="110" height="44" rx="10" {...node} />
          <text x="405" y="82" {...label}>QuickBooks</text>
        </g>
        <g data-node>
          <rect x="350" y="148" width="110" height="44" rx="10" {...node} />
          <text x="405" y="174" {...label}>Sheets</text>
        </g>
        <g data-node>
          <rect x="350" y="240" width="110" height="44" rx="10" {...node} />
          <text x="405" y="266" {...label}>Alerts · reports</text>
        </g>
      </>
    )
  }

  {
    kind === 'whatsapp' && (
      <>
        <path class="ops-line" data-draw d="M130 160 L196 160" />
        <path class="ops-line" data-draw d="M284 160 C 320 160, 320 92, 350 92" />
        <path class="ops-line" data-draw d="M284 160 C 320 160, 320 228, 350 228" />
        <path class="ops-flow" d="M130 160 L196 160" />
        <path class="ops-flow" d="M284 160 C 320 160, 320 92, 350 92" />

        <g data-node>
          <rect x="20" y="134" width="110" height="52" rx="10" {...node} />
          <text x="75" y="157" {...label}>Customers</text>
          <text x="75" y="174" {...sub}>1,000+ chats/day</text>
        </g>
        <g data-node>
          <circle cx="240" cy="160" r="44" fill="#16263C" stroke="#F2A93B" stroke-width="1.5" />
          <text x="240" y="157" {...label}>AI agents</text>
          <text x="240" y="174" {...sub}>sales · support</text>
        </g>
        <g data-node>
          <rect x="350" y="70" width="110" height="44" rx="10" fill="#16263C" stroke="#1FB57A" />
          <text x="405" y="96" {...label}>Resolved</text>
        </g>
        <g data-node>
          <rect x="350" y="206" width="110" height="44" rx="10" {...node} />
          <text x="405" y="232" {...label}>Human handoff</text>
        </g>

        <g data-node>
          <text x="20" y="292" fill="#8FA1B8" font-size="11">Work handled automatically</text>
          <text x="460" y="292" fill="#1FB57A" font-size="11" font-weight="600" text-anchor="end">~70%</text>
          <rect x="20" y="302" width="440" height="8" rx="4" fill="#22344D" />
          <rect x="20" y="302" width="308" height="8" rx="4" fill="#1FB57A" data-bar />
        </g>
      </>
    )
  }

  {
    kind === 'leads' && (
      <>
        <path class="ops-line" data-draw d="M140 84 L180 84" />
        <path class="ops-line" data-draw d="M300 84 L340 84" />
        <path class="ops-line" data-draw d="M400 108 L400 220" />
        <path class="ops-line" data-draw d="M340 244 L300 244" />
        <path class="ops-line" stroke-opacity="0.6" stroke-dasharray="4 6" d="M400 268 C 400 326, 80 326, 80 268" />
        <path class="ops-line" stroke-opacity="0.6" stroke-dasharray="4 6" d="M80 220 C 80 156, 240 156, 240 108" />
        <path class="ops-flow" d="M140 84 L180 84" />
        <path class="ops-flow" d="M300 84 L340 84" />
        <path class="ops-flow" d="M400 108 L400 220" />
        <path class="ops-flow" d="M340 244 L300 244" />

        <g data-node>
          <rect x="20" y="60" width="120" height="48" rx="10" {...node} />
          <text x="80" y="89" {...label}>ZoomInfo</text>
        </g>
        <g data-node>
          <rect x="180" y="60" width="120" height="48" rx="10" {...node} />
          <text x="240" y="89" {...label}>Web enrichment</text>
        </g>
        <g data-node>
          <rect x="340" y="60" width="120" height="48" rx="10" fill="#16263C" stroke="#F2A93B" stroke-width="1.5" />
          <text x="400" y="81" {...label}>Claude scoring</text>
          <text x="400" y="97" {...sub}>decision makers</text>
        </g>
        <g data-node>
          <rect x="340" y="220" width="120" height="48" rx="10" {...node} />
          <text x="400" y="249" {...label}>Pipedrive</text>
        </g>
        <g data-node>
          <rect x="180" y="220" width="120" height="48" rx="10" fill="#16263C" stroke="#1FB57A" />
          <text x="240" y="249" {...label}>Rep alerted</text>
        </g>
        <g data-node>
          <rect x="20" y="220" width="120" height="48" rx="10" {...node} />
          <text x="80" y="241" {...label}>Stale accounts</text>
          <text x="80" y="257" {...sub}>dedupe · re-enrich</text>
        </g>
      </>
    )
  }
</svg>
