---
import { CAL_LINK, testimonials } from './data';

const review = testimonials[0];
---

<section class="relative pb-28 pt-10 md:pb-36 md:pt-16" aria-labelledby="hero-title">
  <div class="ops-container grid items-start gap-16 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)] lg:gap-14">
    <div>
      <h1
        id="hero-title"
        data-hero-reveal
        data-hero-title
        class="text-balance max-w-[16ch] font-display text-[clamp(2.75rem,6.6vw,6rem)] font-semibold leading-[0.96] tracking-[-0.035em] text-ops-ink"
      >
        AI agents that work inside the systems you already run.
      </h1>

      <p data-hero-reveal data-hero-fade class="mt-8 max-w-[36rem] text-lg leading-relaxed text-ops-slate md:text-xl">
        I build LLM agents, RAG pipelines and automations for your CRM, WhatsApp, finance stack and internal tools. They
        run in production, on your real data, every day.
      </p>

      <div data-hero-reveal data-hero-fade class="mt-10 flex flex-col items-start gap-5 sm:flex-row sm:items-center">
        <a href={CAL_LINK} target="_blank" rel="noopener noreferrer" class="ops-btn-primary" data-magnetic>
          Book a discovery call
          <span aria-hidden="true">→</span>
        </a>
        <a href="#work" class="ops-link">
          See the systems
          <span aria-hidden="true">↓</span>
        </a>
      </div>

      <p data-hero-reveal data-hero-fade class="mt-6 flex items-center gap-2 text-sm text-ops-slate">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full rounded-full bg-ops-live opacity-60 motion-safe:animate-ping"
          ></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-ops-live"></span>
        </span>
         Available for new projects. Replies within 24 hours.
      </p>

      <p
        data-hero-reveal
        data-hero-fade
        class="border-ops-ink/15 mt-14 max-w-[42rem] border-t pt-6 text-base leading-relaxed text-ops-slate md:text-lg"
      >
        <strong class="font-semibold tabular-nums text-ops-ink">15+ AI systems</strong> in production,
        <strong class="font-semibold tabular-nums text-ops-ink">10,000+ operations</strong> handled every day and
        <strong class="font-semibold tabular-nums text-ops-ink">120+ hours</strong> a week handed back to client teams.
      </p>
    </div>

    <figure
      data-hero-reveal
      data-hero-panel
      class="relative mx-auto w-full max-w-[22rem] lg:mx-0 lg:mt-3 lg:max-w-none"
    >
      <div data-hero-frame class="aspect-[4/5] overflow-hidden rounded-2xl bg-ops-paper-2">
        <img
          src="/hero.webp"
          alt="Miguel Angel Muñoz, AI Integration Engineer"
          width="960"
          height="957"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover object-[50%_30%]"
        />
      </div>
      <blockquote
        class="absolute -bottom-16 left-4 right-4 rounded-xl bg-white p-5 shadow-[0_24px_48px_-24px_rgb(14_26_43/0.45)] sm:left-auto sm:right-6 sm:w-[17rem] lg:-left-12 lg:right-auto"
      >
        <p class="text-[15px] leading-snug text-ops-ink">“{review.quote}”</p>
        <footer class="mt-3 text-xs text-ops-slate">{review.source}</footer>
      </blockquote>
    </figure>
  </div>
</section>
