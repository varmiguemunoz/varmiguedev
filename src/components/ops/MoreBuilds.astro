---
import { moreBuilds } from './data';
---

<section id="more-builds" class="ops-section scroll-mt-20 pt-0 md:pt-0" aria-labelledby="builds-title" data-builds>
  <div class="ops-container">
    <div class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <h2 id="builds-title" class="font-display text-3xl font-semibold tracking-[-0.03em] text-ops-ink md:text-4xl">
        More builds
      </h2>
      <p class="text-ops-slate">Products, internal tools and client platforms. Open any row for the details.</p>
    </div>

    <ul class="border-t border-ops-ink/15">
      {
        moreBuilds.map((b, i) => (
          <li class="border-b border-ops-ink/15" data-build-row data-metric={b.metric} data-stack={b.stack.slice(0, 4).join(', ')}>
            <h3>
              <button
                type="button"
                class="group grid w-full grid-cols-[1fr_auto] items-center gap-6 py-6 text-left md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)_auto] md:py-7"
                aria-expanded="false"
                aria-controls={`build-panel-${i}`}
                data-build-toggle
              >
                <span class="font-display text-xl font-semibold tracking-[-0.02em] text-ops-ink transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1.5 md:text-2xl">
                  {b.name}
                </span>
                <span class="hidden text-ops-slate md:block">{b.line}</span>
                <span
                  class="grid h-10 w-10 place-items-center rounded-full border border-ops-ink/15 text-ops-ink transition-[background-color,transform,border-color] duration-300 group-hover:border-ops-ink group-aria-expanded:rotate-45 group-aria-expanded:bg-ops-ink group-aria-expanded:text-ops-paper"
                  aria-hidden="true"
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                  </svg>
                </span>
              </button>
            </h3>

            <div id={`build-panel-${i}`} hidden data-build-panel class="overflow-hidden">
              <div class="grid gap-8 pb-10 md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)_2.5rem]">
                <div class="space-y-4">
                  <p class="text-ops-slate md:hidden">{b.line}</p>
                  {b.body.map((p) => (
                    <p class="max-w-[60ch] leading-relaxed text-ops-slate">{p}</p>
                  ))}
                  {b.link && (
                    <a href={b.link} target="_blank" rel="noopener noreferrer" class="ops-link mt-2">
                      Visit {b.name}
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
                <div class="space-y-6">
                  <p class="font-display text-lg font-semibold tracking-[-0.01em] text-ops-ink">{b.metric}</p>
                  {b.features && (
                    <ul class="space-y-2">
                      {b.features.map((f) => (
                        <li class="flex gap-3 text-sm text-ops-slate">
                          <span class="mt-2 h-1 w-1 flex-shrink-0 rounded-full bg-ops-amber" aria-hidden="true" />
                          {f}
                        </li>
                      ))}
                    </ul>
                  )}
                  <ul class="flex flex-wrap gap-2" aria-label="Built with">
                    {b.stack.map((s) => (
                      <li class="ops-chip">{s}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Cursor follower (fine pointers only) -->
  <div
    data-build-follower
    class="pointer-events-none fixed left-0 top-0 z-40 hidden w-64 rounded-xl bg-ops-ink p-4 text-ops-paper opacity-0 shadow-[0_24px_48px_-24px_rgb(14_26_43/0.6)]"
    aria-hidden="true"
  >
    <p class="font-display text-[15px] font-semibold" data-follower-metric></p>
    <p class="mt-1.5 font-mono text-[11px] leading-relaxed text-ops-mist" data-follower-stack></p>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initBuilds() {
    const root = document.querySelector<HTMLElement>('[data-builds]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = 'true';

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    // Expand / collapse
    root.querySelectorAll<HTMLElement>('[data-build-row]').forEach((row) => {
      const btn = row.querySelector<HTMLButtonElement>('[data-build-toggle]');
      const panel = row.querySelector<HTMLElement>('[data-build-panel]');
      if (!btn || !panel) return;

      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', String(open));

        if (reduce) {
          panel.hidden = !open;
          return;
        }
        gsap.killTweensOf(panel);
        if (open) {
          panel.hidden = false;
          gsap.fromTo(panel, { height: 0, opacity: 0 }, { height: 'auto', opacity: 1, duration: 0.6, ease: 'expo.out' });
        } else {
          gsap.to(panel, {
            height: 0,
            opacity: 0,
            duration: 0.4,
            ease: 'power3.inOut',
            onComplete: () => {
              panel.hidden = true;
              gsap.set(panel, { clearProps: 'height,opacity' });
            },
          });
        }
      });
    });

    // Follower card
    const follower = root.querySelector<HTMLElement>('[data-build-follower]');
    if (!follower || !finePointer || reduce) return;
    follower.classList.remove('hidden');
    const metricEl = follower.querySelector('[data-follower-metric]');
    const stackEl = follower.querySelector('[data-follower-stack]');
    const xTo = gsap.quickTo(follower, 'x', { duration: 0.45, ease: 'power3.out' });
    const yTo = gsap.quickTo(follower, 'y', { duration: 0.45, ease: 'power3.out' });

    root.querySelectorAll<HTMLElement>('[data-build-row]').forEach((row) => {
      const btn = row.querySelector<HTMLButtonElement>('[data-build-toggle]');
      if (!btn) return;
      btn.addEventListener('pointerenter', (e) => {
        if (btn.getAttribute('aria-expanded') === 'true') return;
        if (metricEl) metricEl.textContent = row.dataset.metric ?? '';
        if (stackEl) stackEl.textContent = row.dataset.stack ?? '';
        gsap.set(follower, { x: e.clientX + 24, y: e.clientY + 20 });
        gsap.to(follower, { opacity: 1, scale: 1, duration: 0.35, ease: 'expo.out' });
      });
      btn.addEventListener('pointermove', (e) => {
        xTo(e.clientX + 24);
        yTo(e.clientY + 20);
      });
      const hide = () => gsap.to(follower, { opacity: 0, scale: 0.96, duration: 0.25, ease: 'power2.out' });
      btn.addEventListener('pointerleave', hide);
      btn.addEventListener('click', hide);
    });
  }

  document.addEventListener('astro:page-load', initBuilds);
</script>
