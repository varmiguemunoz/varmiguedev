---
import CopyIcon from '@icons/CopyIcon.astro';
import CheckIcon from '@icons/CheckIcon.astro';
---

<pre class="ops-code relative"><button type="button" aria-label="Copy code" class="copy-button absolute right-3 top-3 z-20 grid h-8 w-8 place-items-center rounded-md text-ops-mist transition-colors hover:text-ops-paper"><CopyIcon /></button><span class="check-span pointer-events-none absolute right-3 top-3 z-10 grid h-8 w-8 place-items-center text-ops-live opacity-0 transition-opacity"><CheckIcon /></span><slot /></pre>

<script>
  function initCopy() {
    document.querySelectorAll<HTMLPreElement>('pre.ops-code').forEach((code) => {
      if (code.dataset.bound) return;
      code.dataset.bound = 'true';
      const button = code.querySelector<HTMLButtonElement>('.copy-button');
      const check = code.querySelector('.check-span');
      button?.addEventListener('click', () => {
        navigator.clipboard.writeText(code.textContent?.trim() || '');
        check?.classList.remove('opacity-0');
        button.classList.add('opacity-0');
        setTimeout(() => {
          check?.classList.add('opacity-0');
          button.classList.remove('opacity-0');
        }, 2000);
      });
    });
  }
  document.addEventListener('astro:page-load', initCopy);
</script>
