---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import Posts from '@layouts/Posts.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base>
  <div class="mb-10 flex items-end justify-between">
    <div class="flex flex-col items-start justify-start gap-[8px]">
      <h1 class="text-lg font-semibold leading-6">Blog 📔</h1>
      <p class="text-md opacity-70">Here you can check my latest post.</p>
    </div>

    <a href="/blog">
      <p class="text-md opacity-70 hover:text-white hover:opacity-100">View all post...</p>
    </a>
  </div>

  <Posts posts={posts} />
</Base>
