---
import Base from '@layouts/Base.astro';
import Nav from '@/components/ops/Nav.astro';
import Hero from '@/components/ops/Hero.astro';
import Integrations from '@/components/ops/Integrations.astro';
import CaseScroller from '@/components/ops/CaseScroller.astro';
import MoreBuilds from '@/components/ops/MoreBuilds.astro';
import CaseSelector from '@/components/ops/CaseSelector.astro';
import Process from '@/components/ops/Process.astro';
import MeetMiguel from '@/components/ops/MeetMiguel.astro';
import Testimonials from '@/components/ops/Testimonials.astro';
import FAQ from '@/components/ops/FAQ.astro';
import Contact from '@/components/ops/Contact.astro';
import MobileCTA from '@/components/ops/MobileCTA.astro';
import { faqs } from '@/components/ops/data';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Miguel Angel Muñoz',
    alternateName: 'varmiguemunoz',
    jobTitle: 'AI Integration Engineer',
    url: 'https://www.varmiguemunoz.com/',
    address: { '@type': 'PostalAddress', addressLocality: 'Medellín', addressCountry: 'CO' },
    knowsAbout: ['LLM agents', 'RAG', 'AI automation', 'WhatsApp Business API', 'CRM integrations', 'Node.js', 'Python', 'Go'],
    sameAs: [
      'https://www.linkedin.com/in/varmiguemunoz/',
      'https://github.com/varmiguemunoz',
      'https://www.upwork.com/freelancers/~01c50c885bdb2a6b44',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  theme="ops"
  meta_title="Miguel Muñoz | AI Integration Engineer — LLM Agents, RAG & Automation in Production"
  description="I embed LLM agents, RAG and automation into the CRM, WhatsApp and internal tools your business already runs on. 15+ AI systems in production handling 10,000+ operations a day."
  ogImageTitle="AI agents that work inside the systems you already run."
  ogImageMeta="Miguel Muñoz · AI Integration Engineer"
  schema={schema}
>
  <div data-ops-page class="bg-ops-paper text-ops-ink">
    <Nav />
    <Hero />
    <Integrations />
    <CaseScroller />
    <MoreBuilds />
    <CaseSelector />
    <Process />
    <MeetMiguel />
    <Testimonials />
    <FAQ />
    <Contact />
    <MobileCTA />
  </div>
</Base>

<script>
  import '../scripts/ops-motion';
</script>
