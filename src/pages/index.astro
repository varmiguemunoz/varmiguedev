---
import Base from '@layouts/Base.astro';
import HeroSection from '@/components/global/hero-gsap';
import Brands from '@/components/global/brands/brands.astro';
import brands from '@/config/brands.json';
import About from '@components/global/about-us/about.astro';
import Testimonials from '@/components/global/testimonials/testimonials.astro';
import Workflow from '@/components/global/workflow/workflow.astro';
import FAQ from '@/components/global/faq';
import DiscoveryCall from '@/components/global/discovery-call/discovery.astro';
import Pricing from '@/components/global/pricing/pricing.astro';
import Navbar from '@/components/global/navbar';
---

<Base meta_title="varmiguemunoz Software Engineer| Home" blogpost={true}>
  <Navbar />
  <HeroSection />
  <Brands brands={brands} />
  <About />
  <Pricing />
  <Workflow />
  <Testimonials />
  <FAQ client:load />
  <DiscoveryCall />
</Base>
