---
import Base from '@layouts/Base.astro';
import FAQ from '@/components/global/faq';
import DiscoveryCall from '@/components/global/discovery-call/discovery.astro';
import HeroSection from '@/components/global/hero-gsap';
import Testimonials from '@/components/global/testimonials/testimonials.astro';
import Workflow from '@/components/global/workflow/workflow.astro';
import ValueProposition from '@/components/global/value-proposition/index.astro';
import { Rocket, Route, BadgeDollarSign, MessageSquare, UserPlus, Palette, Briefcase } from 'lucide-react';
import Pricing from '@/components/global/pricing/pricing.astro';
---

<Base title="Agile Development for Agencies | Launch 3× Faster Without an In-House Team">
  <div class="min-h-screen w-full">
    {/* Hero Section */}
    <HeroSection
      client:load
      heroContent={{
        badge: 'Launch Your Own Digital Agency',
        title: [{ text: 'Sell Digital Projects', gradient: true }, { text: ' Without Being a Developer' }],
        description: [
          { text: 'Start your own white-label digital agency in minutes. ' },
          {
            text: 'You sell the services',
            highlight: true,
          },
          { text: ', and our team handles all the delivery and support.' },
          { text: '\n' },
          { text: 'Keep the profit. Build your brand. Scale at your pace.' },
        ],
      }}
      cta={{
        primary: { url: '#pricing', title: 'Start Today for $250' },
        secondary: { url: '#how-it-works', title: 'See How It Works' },
      }}
    />

    {/* How It Works */}
    <Workflow
      heading="How It Works"
      subheading="3 Simple Steps to Your Own Agency"
      description="We make it simple: you focus on selling, we do everything else."
      ctalink="#pricing"
      steps={[
        {
          icon: UserPlus,
          title: 'Join Community',
          description: 'Unlock access for just $10 and enter our private reseller network.',
        },
        {
          icon: Palette,
          title: 'Brand Your Agency',
          description: 'Fill out a quick form — we’ll set up your landing page with your logo and colors.',
        },
        {
          icon: Briefcase,
          title: 'Get Your Sales Kit',
          description: 'Receive ready-to-use posts, scripts, and guides to start generating leads immediately.',
        },
        {
          icon: Rocket,
          title: 'Start Selling & Profit',
          description: 'Offer our catalog under your brand and keep the profit on every project you close.',
        },
      ]}
    />

    {/* Value Proposition / Benefits */}
    <ValueProposition
      items={[
        {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="h-5 w-5"><path d="M5 12h14"/></svg>`,
          bgColor: 'bg-secondary/15',
          textColor: 'text-secondary',
          title: '100% White Label',
          description: 'Everything runs under your brand — clients never see us.',
        },
        {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="h-5 w-5"><path d="M12 3v18M3 12h18"/></svg>`,
          bgColor: 'bg-green-500/15',
          textColor: 'text-green-500',
          title: 'No Tech Needed',
          description: 'We build and deliver the projects. You only sell.',
        },
        {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="h-5 w-5"><path d="M5 12l5 5L20 7"/></svg>`,
          bgColor: 'bg-purple-500/15',
          textColor: 'text-purple-500',
          title: 'Scalable Income',
          description: 'Sell one project a month or dozens — scale at your own pace.',
        },
      ]}
    />

    {/* Catalog of Services */}
    <Pricing
      title="Become a Reseller Agent"
      description="Start your own white-label digital agency with a one-time payment. Get lifetime access to all features and your first month of Community included."
      plan={[
        {
          name: 'Reseller Agent License',
          description: 'Everything you need to launch your agency',
          price: 250,
          stripePriceId: 'price_reseller_agent',
          redirectUrl: '/payment/reselling',
          popular: true,
          hours: '1',
          features: [
            'Lifetime reseller license (one-time fee)',
            'First month of Community subscription included',
            'Access to private reseller channel',
            'Personalized white-label landing page',
            'Sales kit: posts, scripts & checklist',
            'Get access to all our catalog of services for your own agency',
            'Ongoing access to training courses & updates',
          ],
        },
      ]}
    />

    {/* Example Earnings */}
    <Testimonials
      heading="Earnings Potential"
      subheading="See How Our Agents Profit"
      description="Real stories from resellers who turned $250 into a profitable agency model."
      cta={{
        title: 'Want to share your results?',
        cta: 'Join Now for $250',
        link: '#pricing',
      }}
      testimonials={[
        {
          quote:
            'I started focusing on local restaurants. In just 3 weeks I sold a landing page and made $700 profit — more than I ever expected so fast.',
          author: 'Carlos M.',
          company: 'Foodie Digital',
          avatar: '🍽️',
          rating: 5,
        },
        {
          quote:
            'Targeting fitness coaches was the key. Two projects closed in my first month brought in $1,200 profit, all without touching the tech side.',
          author: 'Ana P.',
          company: 'FitPro Agency',
          avatar: '🏋️‍♀️',
          rating: 5,
        },
        {
          quote:
            'I sold one e-commerce setup at $2,000. Since my reseller cost was $1,300, I pocketed $700 in pure profit on my very first client.',
          author: 'David R.',
          company: 'NextGen Stores',
          avatar: '🛒',
          rating: 5,
        },
      ]}
    />

    {/* FAQ */}
    <FAQ
      client:load
      subheading="Your Questions, Answered"
      faqs={[
        {
          question: 'Do I need experience?',
          answer: 'No. You sell, we deliver. Zero tech skills required.',
        },
        {
          question: 'How do I make money?',
          answer: 'You pay reseller prices and sell higher. You keep the margin.',
        },
        {
          question: 'Who builds the projects?',
          answer: 'Our in-house team handles everything, under your brand.',
        },
        {
          question: 'What if my client asks for something custom?',
          answer: 'You can submit a request, and we’ll quote it as a custom project.',
        },
        {
          question: 'Is access really just $250?',
          answer: 'Yes. That unlocks your agency, resources, big tech team, catalog of services and community channel.',
        },
      ]}
    />

    {/* Onboarding - What You Get */}
    <DiscoveryCall
      heading="What You Get When You Join"
      description="For just $250, you unlock everything you need to start selling right away."
      features={[
        { icon: Route, text: 'Private channel with other resellers' },
        { icon: BadgeDollarSign, text: 'Personalized landing with your branding' },
        { icon: MessageSquare, text: 'Ready-to-use posts, scripts & checklist' },
      ]}
      button={{
        label: 'Join Now for $250',
        link: '#pricing',
        note: 'Immediate access',
      }}
    />
  </div>
</Base>
