      {
        description:
          '💬 Step 3: Join the Discovery Call at your scheduled time. We’ll officially welcome you, review your answers, and guide you through your personalized reseller setup.',
      },
    ]}
  />

  <div class="mx-auto w-full max-w-4xl pb-20">
    <iframe
      src="https://crm.growthlyfast.com/widget/booking/ObPxSOgFa5rgIrkCoq8A"
      style="width: 100%;border:none;overflow: hidden;"
      scrolling="no"
      id="ObPxSOgFa5rgIrkCoq8A_1762223380536"
