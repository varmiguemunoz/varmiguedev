---
import Base from '@layouts/Base.astro';
import Success from '@/components/global/success';
---

<Base title="Your consulting session is confirmed 🎉">
  <Success
    client:only
    title="Your consulting session is confirmed 🎯"
    description="Your consulting session has been successfully scheduled. Our team will connect with you to analyze your current challenges, explore potential improvements, and design an actionable roadmap for your business or project."
    steps={[
      {
        description:
          '📅 Step 1: Confirm your time — your meeting details have been sent to your inbox. Please add the event to your calendar to make sure you don’t miss it.',
      },
      {
        description:
          '📝 Step 2: Check your email — you’ll receive a short pre-consultation form to share your goals, current setup, and specific challenges.',
      },
      {
        description:
          '💬 Step 3: During the session, we’ll review your responses, discuss key strategies, and define next steps to optimize your growth or tech execution.',
      },
    ]}
  />

  <div class="mx-auto w-full max-w-4xl pb-20">
    <iframe
      src="https://crm.growthlyfast.com/widget/booking/Z9t8syWDgzmCY2ZFXaVh"
      style="width: 100%;border:none;overflow: hidden;"
      scrolling="no"
      id="Z9t8syWDgzmCY2ZFXaVh_1762223941169"
      title="Strategy Consulting Session"
    >
    </iframe>
    <script src="https://crm.growthlyfast.com/js/form_embed.js" type="text/javascript"></script>
  </div>
</Base>
