---
import { Button } from '@/components/ui/button.tsx';
import { XCircle, ArrowRight, Mail } from 'lucide-react';
import Base from '@layouts/Base.astro';
---

<Base meta_title="Something goes wrong :(">
  <div class="relative min-h-screen overflow-hidden bg-background">
    {/* Background Effects */}
    <div class="bg-gradient-radial absolute inset-0 from-destructive/10 via-transparent to-transparent opacity-50">
    </div>
    <div class="bg-gradient-conic absolute inset-0 from-muted/10 via-accent/5 to-muted/10 opacity-30"></div>
    <div class="bg-noise absolute inset-0 opacity-[0.015]"></div>

    {/* Main Content */}
    <div class="container relative z-10 mx-auto flex min-h-screen items-center justify-center px-4 py-16">
      <div class="mx-auto max-w-4xl text-center">
        {/* Hero Section */}
        <div class="mb-16">
          <div class="mb-8 flex justify-center">
            <div class="rounded-full border border-border/50 bg-muted/20 p-4">
              <XCircle className="h-16 w-16 text-muted-foreground" />
            </div>
          </div>

          <h1
            class="bg-gradient-text mb-6 bg-clip-text text-6xl font-bold leading-tight text-transparent text-white md:text-7xl"
          >
            Payment Cancelled
          </h1>

          <p class="mx-auto max-w-3xl text-xl leading-relaxed text-muted-foreground md:text-2xl">
            No worries — your card has not been charged. You can try again or choose another plan.
          </p>
        </div>

        {/* Reassurance Section */}
        <div
          class="mx-auto mb-12 max-w-2xl rounded-2xl border border-border/50 bg-card/50 p-8 shadow-elegant backdrop-blur-sm md:p-12"
        >
          <h2 class="mb-6 text-2xl font-semibold text-foreground md:text-3xl">What happened?</h2>

          <p class="mb-8 text-lg text-muted-foreground">
            You cancelled the payment process before it was completed. This is completely normal and no charges were
            made to your account.
          </p>

          <div class="rounded-lg border border-border/30 bg-muted/10 p-6">
            <div class="mb-2 flex items-center gap-3">
              <Mail className="h-5 w-5 text-primary" />
              <span class="font-medium text-foreground">Need help choosing?</span>
            </div>
            <p class="text-left text-muted-foreground">
              Our team is here to help you. Feel free to reach out
              with any questions.
            </p>
          </div>
        </div>

        {/* CTA Buttons */}
        <di class="flex flex-col justify-center gap-4 sm:flex-row">
          <a href="/#services">
            <Button variant="hero" size="lg" className="group">
              Back to Services
              <ArrowRight className="h-5 w-5 transition-transform group-hover:translate-x-1" />
            </Button>
          </a>

          <a href="/sales">
            <Button variant="outline" size="lg">Contact Support</Button>
          </a>
        </di>
      </div>
    </div>
  </div>
</Base>
