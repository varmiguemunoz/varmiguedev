---
import DevPricing from '@/components/global/pricing/dev-projects/devpricing.astro';
import Base from '@layouts/Base.astro';
import FAQ from '@/components/global/faq';
import DiscoveryCall from '@/components/global/discovery-call/discovery.astro';
import HeroSection from '@/components/global/hero-gsap';
import Testimonials from '@/components/global/testimonials/testimonials.astro';
import Workflow from '@/components/global/workflow/workflow.astro';
import ValueProposition from '@/components/global/value-proposition/index.astro';
import { Search, Code2, Rocket, HeadphonesIcon, Route, BadgeDollarSign, MessageSquare } from 'lucide-react';
import Pricing from '@/components/global/pricing/pricing.astro';
---

<Base title="Agile Development for Agencies | Launch 3× Faster Without an In-House Team">
  <div class="min-h-screen w-full">
    <HeroSection
      client:load
      heroContent={{
        badge: 'Trusted by 50+ Agencies & Startups',
        title: [
          { text: 'Get Clear on Your Tech Roadmap', gradient: true },
          { text: '\n' },
          { text: 'Before You Invest Thousands' },
        ],
        description: [
          { text: 'Stop guessing with your digital strategy. ' },
          {
            text: 'Our paid consulting sessions',
            highlight: true,
          },
          { text: ' give you clarity on ' },
          {
            text: 'timelines, costs, and the right tech stack',
            highlight: true,
          },
          { text: ' so you can scale without burning budget.' },
          { text: '\n' },
          { text: 'Clear Deliverables. Fixed Price. Actionable Roadmap.' },
        ],
      }}
      cta={{
        primary: { url: '#pricing', title: 'Book Your Session' },
        secondary: { url: '#pricing', title: 'See Consulting Packages' },
      }}
    />

    <ValueProposition
      items={[
        {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="h-5 w-5"><path d="M5 12h14"/></svg>`,
          bgColor: 'bg-secondary/15',
          textColor: 'text-secondary',
          title: 'Tailored Roadmap',
          description: 'Every session ends with a clear action plan aligned with your business goals.',
        },
        {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="h-5 w-5"><path d="M12 3v18M3 12h18"/></svg>`,
          bgColor: 'bg-green-500/15',
          textColor: 'text-green-500',
          title: 'Transparent Pricing',
          description: 'Fixed consulting fees with no hidden upsells — know exactly what you get and what it costs.',
        },
        {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="h-5 w-5"><path d="M5 12l5 5L20 7"/></svg>`,
          bgColor: 'bg-purple-500/15',
          textColor: 'text-purple-500',
          title: 'Expert Insight',
          description: 'Backed by 10+ years building for agencies and startups — practical advice, not theory.',
        },
      ]}
    />

    <Testimonials
      heading="Trusted by Business Owners"
      subheading="Client Results"
      description="See how our consulting sessions helped companies save money and avoid costly mistakes."
      testimonials={[
        {
          quote:
            'The consulting session helped us understand exactly what to build first. We avoided wasting $10k on the wrong feature.',
          author: 'Jessica Miller',
          company: 'UrbanGlow Cosmetics',
          avatar: '🛍️',
          rating: 5,
        },
        {
          quote:
            'In one session, we got clarity on tech choices that would have taken us months to figure out internally.',
          author: 'Daniel Roberts',
          company: 'BrightPath Consulting',
          avatar: '💼',
          rating: 5,
        },
        {
          quote: 'The roadmap PDF gave us a clear step-by-step strategy. It made pitching to investors much easier.',
          author: 'Sophia Taylor',
          company: 'NextGen Marketing',
          avatar: '📈',
          rating: 5,
        },
      ]}
      cta={{
        title: 'Book Your Session Today',
        cta: 'Schedule Consulting ->',
        link: '#pricing',
      }}
    />

    <Pricing
      title="Consulting Packages"
      description="Choose the option that fits your needs. Every session includes a live strategy call and tangible deliverables to guide your next steps."
      plan={[
        {
          name: 'Basic Consulting',
          description: 'Clarity and direction in a single session',
          price: 200,
          stripePriceId: 'price_basic_consulting',
          popular: false,
          hours: '1',
          redirectUrl: '/payment/schedule',
          features: [
            '1-hour live consulting session',
            'Strategic recommendations tailored to your goals',
            'High-level roadmap PDF with next steps',
            'Basic flow diagram of your process or system',
            'Q&A session with actionable advice',
          ],
        },
        {
          name: 'Strategy Consulting',
          description: 'Comprehensive documentation and detailed strategy',
          price: 600,
          stripePriceId: 'price_strategy_consulting',
          popular: true,
          hours: '1.30',
          redirectUrl: '/payment/schedule',
          features: [
            '1-hour and a half live consulting session',
            'Strategic recommendations tailored to your goals',
            'High-level roadmap PDF with next steps',
            'Basic flow diagram of your process or system',
            'Q&A session with actionable advice',
            'Full strategy document with prioritized roadmap',
            'Detailed flow diagrams of processes and systems',
            'Implementation documentation (how-to & tech notes)',
            'Cost and timeline estimates for each milestone',
            'Follow-up Q&A via email (1 week)',
          ],
        },
      ]}
    />

    <Workflow
      heading="How It Works"
      subheading="From Confusion to Clarity"
      description="Our process ensures you walk away with a clear plan, not vague advice."
      advice={false}
      ctalink="#pricing"
      steps={[
        {
          icon: Search,
          title: 'Book & Pay',
          description: 'Secure your consulting session instantly.',
          duration: '1 day',
        },
        {
          icon: Code2,
          title: 'Pre-Session Form',
          description: 'Share your goals, challenges, and current setup.',
          duration: 'Prep before call',
        },
        {
          icon: Rocket,
          title: 'Live Strategy Call',
          description: '90 minutes of tailored guidance with actionable advice.',
          duration: '90 min',
        },
        {
          icon: HeadphonesIcon,
          title: 'Action Plan Delivery',
          description: 'Receive a PDF roadmap with clear next steps.',
          duration: 'Within 48h',
        },
      ]}
    />

    <FAQ
      client:load
      subheading="Your Questions, Answered"
      faqs={[
        {
          question: 'What’s included in the consulting session?',
          answer: 'A live 60-minute strategy call + PDF roadmap with timelines, costs, and priorities.',
        },
        {
          question: 'Is this refundable?',
          answer: 'No, but if you upgrade to a Dev Pack, the consulting fee can be credited.',
        },
        {
          question: 'How soon will I get my roadmap?',
          answer: 'You’ll receive your tailored roadmap within 48 hours after the session.',
        },
        {
          question: 'Can I book multiple sessions?',
          answer: 'Yes, you can purchase the Strategy Package for ongoing support.',
        },
        {
          question: 'What can I expect from a consultation with you?',
          answer:
            'You’ll receive clear, actionable guidance tailored to your business goals. We’ll focus on identifying the best strategies, tools, and next steps for your specific case.',
        },
        {
          question: 'Do I need technical knowledge to benefit from this consultation?',
          answer:
            'Not at all. We’ll explain everything in plain language so you can make informed decisions without needing a technical background.',
        },
        {
          question: 'Can you help me choose the right technology stack or platform?',
          answer: 'Yes. We’ll recommend the best tools and platforms based on your goals, budget, and growth stage.',
        },
        {
          question: 'Will you provide a detailed plan or just advice?',
          answer: 'You’ll get both: actionable advice during the call and a written PDF roadmap with clear next steps.',
        },
        {
          question: 'Do you offer hands-on implementation after the consultation?',
          answer:
            'Yes. If you’d like us to implement the roadmap, you can move forward with a Dev Pack or project engagement.',
        },
      ]}
    />

    <DiscoveryCall
      heading="Let’s Define Your Tech Roadmap"
      description="Book your paid consulting session to avoid costly mistakes and move forward with confidence."
      features={[
        { icon: Route, text: 'Actionable roadmap tailored to your business' },
        { icon: BadgeDollarSign, text: 'Understand costs & delivery timelines upfront' },
        { icon: MessageSquare, text: 'Direct answers from experienced developers' },
      ]}
      button={{
        label: 'Schedule Consulting',
        link: '#pricing',
        note: 'Immediate response',
      }}
    />
  </div>
</Base>
