---
import Base from '@layouts/Base.astro';
import Navbar from '@/components/global/navbar';
---

<Base title="Book Your Call with the GrowthlyFast Team 🚀">
  <Navbar client:load />
  <div class="mx-auto mb-16 flex max-w-5xl flex-col items-center justify-center pt-20">
    <div class="mb-8 flex justify-center">
      <div class="rounded-full bg-gradient-primary p-4 shadow-glow">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-primary-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
          <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
      </div>
    </div>

    <h1
      class="bg-gradient-text mb-6 bg-clip-text text-center text-3xl font-bold leading-tight text-transparent text-white md:text-7xl"
    >
      Book Your Free Call with me
    </h1>

    <p class="mx-auto max-w-3xl text-center text-xl leading-relaxed text-muted-foreground md:text-2xl">
      Let’s talk about your project, idea, or open roleand see how I can help you build, optimize, or scale your
      product. 🚀
    </p>
  </div>

  <div class="mx-auto w-full max-w-4xl pb-20">
    <iframe
      src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ3T7zeEOYTFQmof-sbNifFo37K0uW123TO1tf3L6AEUr-2qhDbR8Txol7-9zoAdi6NfmfNTOtQs?gv=true"
      style="border: 0"
      width="100%"
      height="600"
      frameborder="0"
      title="Book a Call — Google Calendar"
      loading="lazy"
    ></iframe>
  </div>
</Base>
