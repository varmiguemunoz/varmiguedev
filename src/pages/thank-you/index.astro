---
import Success from '@/components/global/success';
import Base from '@/layouts/Base.astro';
---

<Base title="Your meeting is confirmed 🎉">
  <Success
    client:only
    title="Your meeting is confirmed"
    description="Your meeting has been successfully scheduled. Our team will be ready to connect, learn more about your goals, and outline the best next steps for you"
    steps={[
      {
        description: 'We’ve sent a confirmation email with your meeting details and the link to join.',
      },
      {
        description: 'Add the meeting to your calendar to make sure you don’t miss it.',
      },
      {
        description: 'Our team will review your information and be ready to discuss your goals during the call.',
      },
    ]}
  />
</Base>
