---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import Nav from '@/components/ops/Nav.astro';
import Contact from '@/components/ops/Contact.astro';
import config from '@config/config.json';
import { categoryLabel, formatDate, isoDate } from '@/components/ops/blog/utils';

export async function getStaticPaths({ paginate }: any) {
  const posts = (await getCollection('blog'))
    .filter((post) => post.data.draft !== true)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 12 });
}

const { page } = Astro.props as any;
const posts = page.data as any[];
const isFirst = page.currentPage === 1;
const [lead, ...rest] = isFirst ? posts : [null, ...posts];
const base = config.site.base_url.replace(/\/$/, '');

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Notes from production',
    url: `${base}/blog`,
    author: { '@type': 'Person', name: 'Miguel Angel Muñoz', url: base },
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: `${base}/blog/${p.slug}`,
      datePublished: isoDate(p.data.pubDate),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: base },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${base}/blog` },
    ],
  },
];
---

<Base
  meta_title={isFirst ? 'Blog | Miguel Muñoz, AI Integration Engineer' : `Blog, page ${page.currentPage} | Miguel Muñoz`}
  description="Notes on building AI agents, RAG, WhatsApp automation and Go and Node.js backends that run in production, from Miguel Angel Muñoz."
  ogImageTitle="Notes from production"
  ogImageMeta="Miguel Muñoz, AI Integration Engineer"
  schema={schema}
>
  <div class="bg-ops-paper text-ops-ink">
    <Nav />

    <header class="ops-container pb-14 pt-16 md:pb-20 md:pt-24">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:items-end">
        <h1 class="max-w-[14ch] text-balance font-display text-[clamp(2.75rem,6vw,5rem)] font-semibold leading-[0.98] tracking-[-0.035em]">
          Notes from production.
        </h1>
        <p class="ops-lead lg:justify-self-end">
          What I learn building AI agents, automations and backends that run on real company data. Architecture,
          trade-offs and the parts that broke.
        </p>
      </div>
    </header>

    <main class="ops-container pb-24 md:pb-32">
      {
        lead && (
          <a
            href={`/blog/${lead.slug}`}
            class="group grid gap-6 border-t-2 border-ops-ink py-10 md:py-14 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:gap-16"
          >
            <h2 class="text-balance font-display text-[clamp(2rem,4vw,3.25rem)] font-semibold leading-[1.05] tracking-[-0.03em] decoration-ops-amber decoration-2 underline-offset-[0.18em] group-hover:underline">
              {lead.data.title}
            </h2>
            <div class="flex flex-col justify-between gap-6">
              <p class="text-lg leading-relaxed text-ops-slate">{lead.data.description}</p>
              <p class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-ops-slate">
                <span class="font-semibold text-ops-ink">Latest</span>
                <time datetime={isoDate(lead.data.pubDate)} class="tabular-nums">{formatDate(lead.data.pubDate)}</time>
                <span>{categoryLabel(lead.data.category)}</span>
                {lead.data.readtime && <span>{lead.data.readtime}</span>}
                <span class="ml-auto font-semibold text-ops-ink" aria-hidden="true">Read →</span>
              </p>
            </div>
          </a>
        )
      }

      <ol class="border-t border-ops-ink/15">
        {
          rest.map((p) => (
            <li class="border-b border-ops-ink/15">
              <a
                href={`/blog/${p.slug}`}
                class="group grid gap-3 py-8 md:grid-cols-[8.5rem_minmax(0,1fr)_9rem] md:gap-10 md:py-9"
              >
                <time datetime={isoDate(p.data.pubDate)} class="pt-1 text-sm tabular-nums text-ops-slate">
                  {formatDate(p.data.pubDate)}
                </time>
                <span>
                  <span class="block font-display text-xl font-semibold leading-snug tracking-[-0.015em] decoration-ops-amber decoration-2 underline-offset-[0.2em] group-hover:underline md:text-2xl">
                    {p.data.title}
                  </span>
                  <span class="mt-2 line-clamp-2 block max-w-[65ch] leading-relaxed text-ops-slate">{p.data.description}</span>
                </span>
                <span class="flex gap-4 pt-1 text-sm text-ops-slate md:flex-col md:gap-1 md:text-right">
                  <span>{categoryLabel(p.data.category)}</span>
                  {p.data.readtime && <span>{p.data.readtime}</span>}
                </span>
              </a>
            </li>
          ))
        }
      </ol>

      {
        (page.url.prev || page.url.next) && (
          <nav class="mt-12 flex items-center justify-between text-sm" aria-label="Blog pages">
            {page.url.prev ? (
              <a href={page.url.prev} class="ops-link">
                <span aria-hidden="true">←</span> Newer posts
              </a>
            ) : (
              <span />
            )}
            {page.url.next && (
              <a href={page.url.next} class="ops-link">
                Older posts <span aria-hidden="true">→</span>
              </a>
            )}
          </nav>
        )
      }
    </main>

    <Contact />
  </div>
</Base>
