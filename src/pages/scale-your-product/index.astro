---
import Pricing from '@/components/global/pricing/pricing.astro';
import Base from '@layouts/Base.astro';
import FAQ from '@/components/global/faq';
import DiscoveryCall from '@/components/global/discovery-call/discovery.astro';
import Video from '@/components/global/video/video.astro';
import HeroSection from '@/components/global/hero-gsap';
import Testimonials from '@/components/global/testimonials/testimonials.astro';
import Workflow from '@/components/global/workflow/workflow.astro';
import SalesContactForm from '@/components/global/sales-form';
import MiniCaseStudies from '@/components/global/mini-case-studies/index.astro';
import ValueProposition from '@/components/global/value-proposition/index.astro';
import FormMarketing from '@/components/global/sales-form/form-marketing';
---

<Base title="Senior Software Engineer | Scale Your Agency with a digital partner">
  <div class="min-h-screen w-full">
    <HeroSection client:load cta={{ secondary: { url: '#mini-case-studies', title: 'View Real Cases' } }} />
    <MiniCaseStudies />
    <ValueProposition />
    <Testimonials />
    <Video />
    <Pricing />
    <Workflow />
    <FormMarketing client:load />
